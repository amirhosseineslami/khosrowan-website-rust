# ---------------------------------------------------------------------------
# personal-site — configuration
# Copy to `.env` and adjust. Every value has a sensible default for local
# development; the ones marked REQUIRED must be changed before deploying.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
APP_ENV=development          # development | production
HOST=0.0.0.0
PORT=3000
BASE_URL=http://localhost:3000

# REQUIRED in production: at least 32 random characters.
# Generate one with:  openssl rand -base64 48
APP_SECRET=dev-only-insecure-secret-change-me

# --- Database --------------------------------------------------------------
DATABASE_URL=sqlite://data/personal-site.db?mode=rwc

# --- Storage ---------------------------------------------------------------
MEDIA_DIR=media
ASSETS_DIR=assets

# --- Sessions --------------------------------------------------------------
SESSION_TTL_SECONDS=14400       # 4 hours
REMEMBER_TTL_SECONDS=2592000    # 30 days

# --- Bootstrap administrator ----------------------------------------------
# Used only when the database is empty. Change the password before deploying!
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345

# --- Mail (SMTP) -----------------------------------------------------------
# Leave SMTP_HOST empty to log e-mails instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME=Personal Site
SMTP_DRY_RUN=true

# --- Limits ----------------------------------------------------------------
MAX_BODY_SIZE=2097152           # 2 MiB
MAX_UPLOAD_SIZE=10485760        # 10 MiB

# --- Feature switches ------------------------------------------------------
CONTACT_ENABLED=true
SITE_VISIBLE=true

# --- Logging ---------------------------------------------------------------
RUST_LOG=info,tower_http=warn,sqlx=warn

# Cache-Control for khosrowan Pages site
# HTML: short edge cache so repeat visits hit edge instead of origin
/*
  Cache-Control: public, max-age=600, stale-while-revalidate=86400

/assets/css/*
  Cache-Control: public, max-age=86400, immutable
/assets/js/*
  Cache-Control: public, max-age=86400, immutable
/assets/img/*
  Cache-Control: public, max-age=86400, immutable
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/files/*
  Cache-Control: public, max-age=31536000, immutable
